{
  "name": "gsf-agent-plugin-experiment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "schema:fetch": "mkdir -p .cache && curl --fail --silent --show-error https://agent-plugins.org/schemas/1.0.0/plugin.schema.json -o .cache/plugin.schema.json",
    "validate": "node scripts/validate-plugin.mjs && validate-skills --skills-dir green-software/skills --verbose",
    "test": "node --test scripts/validate-plugin.test.mjs",
    "build": "npm run validate && mkdir -p dist && tar -czf dist/green-software-0.1.0.tar.gz green-software"
  },
  "devDependencies": {
    "@prompt-registry/collection-scripts": "1.0.6",
    "ajv": "8.20.0"
  }
}
